{"nodes": [{"id": "designing_enterprise_apis_ai_agents_v2_working_article", "label": "Designing Enterprise APIs for the Age of AI Agents (V2)", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_backend_business_authority", "label": "The Backend Remains the Business Authority", "file_type": "rationale", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent may interpret intent and request actions; deterministic systems decide what is valid, authorized, safe and executed."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_probabilistic_callers", "label": "Deterministic Clients to Probabilistic Callers", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents select tools, infer parameters, chain calls and retry, so agent-generated requests must be treated as untrusted input."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_agent_boundary", "label": "Agent Boundary", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep enterprise APIs domain-oriented and put a dedicated agent-facing layer in front of them instead of reshaping every API for LLMs."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_agent_facing_interaction_layer", "label": "Agent-Facing Interaction Layer", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes a small set of semantically clear operations (e.g. find_customer_orders) that orchestrate several domain APIs."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_mcp", "label": "Model Context Protocol (MCP) Tools, Resources, Prompts", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCP standardizes capability exposure but does not provide memory, workflow state, retries or orchestration."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_semantic_tool_contracts", "label": "Small, Strict and Typed Tool Contracts", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focused tools with explicit schemas and descriptions reduce ambiguity during tool selection."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_idempotency", "label": "Idempotency and Side Effects", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent runtimes retry after ambiguous failures, so state-changing tools must be idempotent (Idempotency-Key)."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_backend_validation", "label": "Strong Backend Validation", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L197", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business validation and authorization always happen server-side regardless of the tool schema."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_semantic_status", "label": "Explicit Semantic States", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L203", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return runtime-interpretable states (CLARIFICATION_REQUIRED, RATE_LIMITED, BUDGET_EXCEEDED...) instead of generic HTTP failures."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_identity_across_boundary", "label": "Identity Must Survive the Agent Boundary", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each boundary reduces trust; tool access does not imply access to every resource behind the tool."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_user_delegated_identity", "label": "User-Delegated Identity", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L266", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_service_identity", "label": "Service Identity", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_multi_boundary_authorization", "label": "Authorize at More Than One Boundary", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool authorization and business/resource authorization are distinct checks."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_human_confirmation", "label": "Least Privilege and Human Confirmation", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L300", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consequential actions require explicit confirmation, but confirmation never replaces authorization."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_controlled_dictionaries", "label": "Controlled Dictionaries and Taxonomies", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L319", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enterprise semantics resolve through governed catalogs the agent cannot modify without human review."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_untrusted_context", "label": "Untrusted Context", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent is untrusted, and so is the context influencing it; context does not gain authority by entering the prompt."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_prompt_injection", "label": "Prompt Injection as a Trust-Boundary Problem", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L363", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_model_not_security_boundary", "label": "Do Not Use the Model as the Security Boundary", "file_type": "rationale", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L406", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic controls (schema validation, authorization, business rules, confirmation) must hold even if context corrupts model reasoning."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_blast_radius", "label": "Limit the Blast Radius", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L429", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expose only tools needed for the current workflow and prefer read-only capabilities."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_provenance", "label": "Preserve Provenance", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L462", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Context carries source_type, source_system, resource_id, trust_level for security analysis, auditing and source-specific policy."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_three_layer_testing", "label": "API/Domain Tests + Tool Contract Tests + Agent Behavior Evals", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L488", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_tool_contract_tests", "label": "Tool Contract Tests", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L511", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_agent_behavior_evals", "label": "Agent Behavior Evals (Golden Scenarios)", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L524", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assert behavioral properties (correct tool, no invented params, confirmation before side effect) rather than exact wording."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_behavioral_drift", "label": "Behavioral Drift Regression", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L563", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_behavioral_contract", "label": "Tool Descriptions Are Part of the Behavioral Contract", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L595", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designing_enterprise_apis_ai_agents_v2_working_tool_contract_versioning", "label": "Version Tool Contracts Deliberately", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L617", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Record tool/contract version in production traces and roll out behavioral changes deliberately."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_observability_layers", "label": "Observability Across Three Layers (Technical, Agent, Business)", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L661", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlate technical telemetry, agent decisions and business outcomes across the full workflow."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_rate_limiting", "label": "Rate Limiting (user, session, tool, loop protection)", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L720", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate limiting answers how frequently a caller may invoke the system."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_cost_governance", "label": "Cost Governance and Execution Budgets", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L734", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost governance answers how expensive one successful execution may become; distinct from rate limiting."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_long_running_operations", "label": "Explicit Long-Running Operations (job / status / result)", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L764", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async job states (PENDING, RUNNING, COMPLETED, FAILED, CANCELLED) prevent the agent guessing after timeouts."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_retry_semantics", "label": "Retries and Timeouts Need Deterministic Semantics", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L810", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime must know if an operation is safe to retry; retries bounded by idempotency, max attempts and cost."}, {"id": "designing_enterprise_apis_ai_agents_v2_working_fail_safely", "label": "Fail Safely Under Operational Pressure", "file_type": "document", "source_file": "code/docs/Designing_Enterprise_APIs_AI_Agents_V2_working.md", "source_location": "L850", "source_url": null, "captured_at": null,